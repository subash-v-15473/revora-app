rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'revoraadmin@revora.com';
    }
    // Cars: anyone can browse; only the admin can add or change.
    match /cars/{carId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Photos: stored as compressed data URLs; anyone can view, only the admin can add or remove.
    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Appointments: anyone can book (create) with a sane shape; only the admin can read, change or delete.
    match /appointments/{apptId} {
      allow create: if request.resource.data.keys().hasAll(['carId','carTitle','name','phone','date','time','status','createdAt'])
                    && request.resource.data.status == 'new'
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 120
                    && request.resource.data.phone is string && request.resource.data.phone.size() < 40
                    && (!('note' in request.resource.data) || request.resource.data.note.size() < 500);
      allow read, update, delete: if isAdmin();
    }
  }
}
