rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'revoraadmin@revora.com'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    match /cars/{carId}     { allow read: if true; allow write: if isAdmin(); }
    match /photos/{photoId} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /admins/{uid}     { allow read, write: if isAdmin(); }
    match /buyers/{id}      { allow read, write: if isAdmin(); }
    match /appointments/{apptId} {
      allow create: if request.resource.data.keys().hasAll(['carId','carTitle','name','phone','date','time','status','createdAt'])
                    && request.resource.data.status == 'new'
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 120
                    && request.resource.data.phone is string && request.resource.data.phone.size() < 40
                    && (!('note' in request.resource.data) || request.resource.data.note.size() < 500);
      allow read, update, delete: if isAdmin();
    }
  }
}
